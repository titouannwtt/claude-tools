{
  "_lisez-moi": "JSON-LD entity graph template. Remove this key before publishing. Replace each [PARAMETER]. A single <script type=\"application/ld+json\"> block per page holds the graph; page-specific nodes (WebApplication, BlogPosting, FAQPage) only go on the pages concerned. Declare only sameAs profiles that are real and maintained by the project. No invented aggregate rating. Dates come from the date register (dateModified = visible text changed).",
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://[DOMAIN]/#organization",
      "name": "[NAME]",
      "url": "https://[DOMAIN]/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://[DOMAIN]/logo-512.png",
        "width": 512,
        "height": 512
      },
      "sameAs": [
        "[Google Play or App Store listing URL]",
        "[AlternativeTo listing URL]",
        "[SaaSHub listing URL]",
        "[review profile URL]",
        "[Wikidata URL, only if the item exists]",
        "[YouTube channel URL, only if it exists]",
        "[GitHub examples repository URL, only if it exists]"
      ],
      "founder": { "@id": "https://[DOMAIN]/#founder" }
    },
    {
      "@type": "Person",
      "@id": "https://[DOMAIN]/#founder",
      "name": "[PUBLISHER OR FOUNDER NAME]",
      "worksFor": { "@id": "https://[DOMAIN]/#organization" }
    },
    {
      "@type": "WebSite",
      "@id": "https://[DOMAIN]/#website",
      "name": "[NAME]",
      "url": "https://[DOMAIN]/",
      "publisher": { "@id": "https://[DOMAIN]/#organization" },
      "inLanguage": ["en", "fr", "es", "de", "it", "pt", "nl", "pl", "ja", "ko"]
    },
    {
      "@type": "WebPage",
      "@id": "https://[DOMAIN]/[PATH]/#webpage",
      "url": "https://[DOMAIN]/[PATH]/",
      "name": "[PAGE TITLE]",
      "inLanguage": "[LANGUAGE]",
      "isPartOf": { "@id": "https://[DOMAIN]/#website" },
      "dateModified": "[YYYY-MM-DD]",
      "primaryImageOfPage": { "@id": "https://[DOMAIN]/[PATH]/#primaryimage" },
      "breadcrumb": { "@id": "https://[DOMAIN]/[PATH]/#breadcrumb" }
    },
    {
      "@type": "ImageObject",
      "@id": "https://[DOMAIN]/[PATH]/#primaryimage",
      "url": "https://[DOMAIN]/[OG-IMAGE].webp",
      "width": 1200,
      "height": 630,
      "caption": "[LOCALIZED IMAGE ALT TEXT]"
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://[DOMAIN]/[PATH]/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "[LOCALIZED HOME]", "item": "https://[DOMAIN]/" },
        { "@type": "ListItem", "position": 2, "name": "[LOCALIZED SECTION]", "item": "https://[DOMAIN]/[SECTION]/" },
        { "@type": "ListItem", "position": 3, "name": "[LOCALIZED PAGE]", "item": "https://[DOMAIN]/[PATH]/" }
      ]
    },
    {
      "@type": "WebApplication",
      "@id": "https://[DOMAIN]/[PATH]/#software",
      "name": "[TOOL NAME]",
      "url": "https://[DOMAIN]/[PATH]/",
      "applicationCategory": "[MultimediaApplication | UtilitiesApplication | ...]",
      "operatingSystem": "[Web, Android; exact: add iOS only if published, otherwise describe the beta in the text]",
      "browserRequirements": "[e.g. Chrome or Edge for Web MIDI]",
      "inLanguage": ["en", "fr"],
      "isAccessibleForFree": true,
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" },
      "provider": { "@id": "https://[DOMAIN]/#organization" },
      "publisher": { "@id": "https://[DOMAIN]/#organization" }
    },
    {
      "@type": "MobileApplication",
      "@id": "https://[DOMAIN]/#android-app",
      "name": "[NAME]",
      "operatingSystem": "Android",
      "applicationCategory": "[CATEGORY]",
      "installUrl": "[Google Play URL]",
      "provider": { "@id": "https://[DOMAIN]/#organization" }
    },
    {
      "@type": "BlogPosting",
      "@id": "https://[DOMAIN]/blog/[SLUG]/#article",
      "headline": "[ARTICLE TITLE]",
      "mainEntityOfPage": { "@id": "https://[DOMAIN]/blog/[SLUG]/#webpage" },
      "image": ["https://[DOMAIN]/[IMAGE].webp"],
      "datePublished": "[YYYY-MM-DD]",
      "dateModified": "[YYYY-MM-DD]",
      "inLanguage": "[LANGUAGE]",
      "author": { "@id": "https://[DOMAIN]/#founder" },
      "publisher": { "@id": "https://[DOMAIN]/#organization" }
    },
    {
      "@type": "FAQPage",
      "@id": "https://[DOMAIN]/[PATH]/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "[QUESTION 1, copied word for word from the visible text]",
          "acceptedAnswer": { "@type": "Answer", "text": "[ANSWER 1, identical to the visible text]" }
        },
        {
          "@type": "Question",
          "name": "[QUESTION 2]",
          "acceptedAnswer": { "@type": "Answer", "text": "[ANSWER 2]" }
        }
      ]
    },
    {
      "@type": "VideoObject",
      "@id": "https://[DOMAIN]/[PATH]/#video",
      "name": "[VIDEO TITLE]",
      "description": "[DESCRIPTION]",
      "thumbnailUrl": "https://[DOMAIN]/[THUMBNAIL].webp",
      "uploadDate": "[YYYY-MM-DD]",
      "duration": "PT1M",
      "embedUrl": "https://www.youtube-nocookie.com/embed/[ID]"
    },
    {
      "@type": "DefinedTermSet",
      "@id": "https://[DOMAIN]/glossaire/#termset",
      "name": "[GLOSSARY NAME]",
      "hasDefinedTerm": [
        {
          "@type": "DefinedTerm",
          "name": "[TERM]",
          "description": "[DEFINITION, identical to the visible text]",
          "inDefinedTermSet": { "@id": "https://[DOMAIN]/glossaire/#termset" }
        }
      ]
    }
  ]
}
