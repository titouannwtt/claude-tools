# Copy to local.env (ignored by git, chmod 600). Every key is optional.
# Terms the pre-commit check must block (your name, handle, domains), comma-separated, case-insensitive.
FORBIDDEN_TERMS=
# Public strings that contain a forbidden term on purpose (e.g. your GitHub handle), comma-separated.
ALLOWED_TERMS=
# Residential proxy used only as a fallback by web-fetch, site-design, media-download and video-transcript.
IPROYAL_RESIDENTIAL_URL=
# Second machine kept in sync by tools/publish_skill.sh (ssh arguments, optional pre-command, repo path).
PEER_SSH=
PEER_PRE=
PEER_REPO=
